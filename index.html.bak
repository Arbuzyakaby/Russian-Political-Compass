    ],
    why:"Самая прорыночная позиция в списке: дерегулирование, поддержка частной инициативы и снижение налогов. Ниже нуля по вертикали — партия последовательно выступает за сокращение вмешательства государства в бизнес и частную жизнь, хотя остаётся системной и не оспаривает политическое устройство."
  },
  {
    id:"yabloko", name:"Яблоко", short:"Яблоко", tag:"Яблоко", lp:"bottom",
    seats:0, color:"#22c55e", x:-3.0, y:-8.0,
    ideology:"Социальный либерализм, правозащитная демократия",
    theses:[
      "Верховенство права, независимость судов, свобода слова и собраний",
      "Демократизация выборов, парламентская республика, децентрализация власти",
      "Социально ориентированная рыночная экономика, сильная социальная защита",
      "Последовательная антивоенная и антимилитаристская позиция"
    ],
    why:"Экономически — левее центра: рынок с развитой социальной политикой европейского образца. По вертикальной оси занимает крайнюю либертарианскую точку: ни одна другая партия в списке не строит программу вокруг ограничения полномочий государства и защиты прав человека настолько последовательно."
  },
  {
    id:"kr", name:"Коммунисты России", short:"Коммунисты России", tag:"Коммунисты России", lp:"top",
    seats:0, color:"#991b1b", x:-9.0, y:5.5,
    ideology:"Ортодоксальный коммунизм сталинистского толка",
    theses:[
      "Полная национализация экономики и возврат к плановой советской модели",
      "Реабилитация фигуры Сталина и мобилизационной модели государства",
      "«10 сталинских ударов по капитализму» как программный документ",
      "Радикальная критика КПРФ за оппортунизм и соглашательство"
    ],
    why:"Программа более радикальна, чем у КПРФ: не частичная, а тотальная национализация — отсюда крайняя левая точка. По вертикали выше КПРФ, поскольку партия открыто апеллирует к жёсткой мобилизационной государственности и не выдвигает требований расширения гражданских свобод."
  },
  {
    id:"pens", name:"Партия пенсионеров за социальную справедливость", short:"Партия пенсионеров", tag:"Партия пенсионеров", lp:"bottom",
    seats:0, color:"#a855f7", x:-4.2, y:3.2,
    ideology:"Левый социальный консерватизм",
    theses:[
      "Повышение пенсий, индексация выплат работающим пенсионерам",
      "Бесплатная медицина и лекарственное обеспечение для старшего поколения",
      "Государственный контроль над тарифами ЖКХ и социальной сферой",
      "Отсутствие радикальной политической повестки, системная лояльность"
    ],
    why:"Экономически левая позиция: перераспределение в пользу социально уязвимых групп и расширение государственных обязательств. По вертикали умеренно выше центра — партия просит от государства больше социального патернализма и не поднимает вопросов гражданских прав или ограничения власти."
  },
  {
    id:"green", name:"Российская экологическая партия «Зелёные»", short:"Зелёные", tag:"«Зелёные»", lp:"top",
    seats:0, color:"#10b981", x:-1.0, y:-1.5,
    ideology:"Экологизм, умеренный центризм",
    theses:[
      "Экологическая безопасность как приоритет государственной политики",
      "Ужесточение ответственности промышленности за загрязнение",
      "Раздельный сбор отходов, «зелёная» энергетика, защита лесов и вод",
      "Поддержка общественного экологического контроля и местных инициатив"
    ],
    why:"Ближе всего к центру координат: экологическая повестка не привязана ни к плановой, ни к рыночной модели, а лёгкий левый крен даёт требование регулировать промышленность. Чуть ниже нуля по вертикали — партия делает ставку на гражданский и общественный контроль, а не на административное принуждение."
  },
  {
    id:"rodina", name:"Родина", short:"Родина", tag:"Родина", lp:"right",
    seats:1, color:"#0e4b8f", x:2.0, y:6.2,
    ideology:"Национал-консерватизм, державный патриотизм",
    theses:[
      "Защита традиционных ценностей и русской национальной идентичности",
      "Мощный оборонно-промышленный комплекс и мобилизационная экономика",
      "Смешанная модель: госконтроль над стратегическими отраслями плюс частный сектор",
      "Жёсткая миграционная политика и «русский вопрос» в центре повестки"
    ],
    why:"Экономика — около центра с небольшим сдвигом вправо: партия не требует национализации, но настаивает на государственном руководстве стратегическими отраслями. Высокий этатизм обусловлен культом сильного государства, мобилизационной риторикой и приоритетом безопасности над личными свободами."
  },
  {
    id:"ppd", name:"Партия Прямой Демократии", short:"Прямая демократия", tag:"Прямая демократия", lp:"top",
    seats:0, color:"#06b6d4", x:2.5, y:-7.0,
    ideology:"Цифровая прямая демократия, технолибертарианство",
    theses:[
      "Электронные референдумы: граждане голосуют по законам напрямую",
      "Сокращение роли бюрократии и посреднических представительных институтов",
      "Поддержка IT-отрасли, геймдева и цифрового предпринимательства",
      "Децентрализация принятия решений на уровень сообществ"
    ],
    why:"Умеренно правая экономика: ставка на технологический бизнес и предпринимательскую среду без перераспределительной программы. По вертикали — одна из самых либертарианских точек: сама идея прямой демократии предполагает передачу власти от государственного аппарата гражданам."
  }
];
const TOTAL_SEATS = 450;

const SIZE=660, PAD=76, C=SIZE/2, K=(SIZE/2-PAD)/10;
const svg=document.getElementById('svg'), NS="http://www.w3.org/2000/svg";
const px=(x,y)=>({sx:C+x*K, sy:C-y*K});
const fmt=v=>(v>0?"+":"")+v.toFixed(1);
const radius=p=>9 + Math.min(6, Math.sqrt(p.seats)*0.36);
function el(t,a={},txt){const e=document.createElementNS(NS,t);for(const k in a)e.setAttribute(k,a[k]);if(txt!=null)e.textContent=txt;return e;}

let active=null, filter="all", query="", cross;

/* ---- защита подписей от наложений ---- */
let obstacles=[];
const PADR=3;
function rectOf(node,dx=0,dy=0,pad=PADR){
  const b=node.getBBox();
  return {x1:b.x+dx-pad,y1:b.y+dy-pad,x2:b.x+b.width+dx+pad,y2:b.y+b.height+dy+pad};
}
function hits(a){return obstacles.some(o=>!(a.x2<=o.x1||a.x1>=o.x2||a.y2<=o.y1||a.y1>=o.y2));}
function inside(a){return a.x1>=6&&a.x2<=SIZE-6&&a.y1>=6&&a.y2<=SIZE-6;}
function place(tag,seat,dx,dy,r,pos){
  const o={
    top:   {x:0,      y:-(r+11), a:"middle", sy:-(r+23)},
    bottom:{x:0,      y:(r+18),  a:"middle", sy:(r+30)},
    left:  {x:-(r+8), y:4,       a:"end",    sy:16},
    right: {x:(r+8),  y:4,       a:"start",  sy:16}
  }[pos];
  tag.setAttribute("x",o.x);tag.setAttribute("y",o.y);tag.setAttribute("text-anchor",o.a);
  seat.setAttribute("x",o.x);seat.setAttribute("y",o.sy);seat.setAttribute("text-anchor",o.a);
  return rectOf(tag,dx,dy);
}

function draw(){
  svg.innerHTML="";
  const defs=el("defs");
  [{id:"gq1",c:"#ef4444"},{id:"gq2",c:"#a855f7"},{id:"gq3",c:"#38bdf8"},{id:"gq4",c:"#fbbf24"}].forEach(q=>{
    const g=el("radialGradient",{id:q.id});
    g.appendChild(el("stop",{offset:"0%","stop-color":q.c,"stop-opacity":".20"}));
    g.appendChild(el("stop",{offset:"100%","stop-color":q.c,"stop-opacity":".03"}));
    defs.appendChild(g);
  });
  const glow=el("filter",{id:"glow",x:"-60%",y:"-60%",width:"220%",height:"220%"});
  glow.appendChild(el("feGaussianBlur",{stdDeviation:"5",result:"b"}));
  const mg=el("feMerge");mg.appendChild(el("feMergeNode",{in:"b"}));mg.appendChild(el("feMergeNode",{in:"SourceGraphic"}));
  glow.appendChild(mg);defs.appendChild(glow);
  svg.appendChild(defs);

  const H=C-PAD;
  [[PAD,PAD,"gq1"],[C,PAD,"gq2"],[PAD,C,"gq3"],[C,C,"gq4"]].forEach(r=>
    svg.appendChild(el("rect",{class:"quad",x:r[0],y:r[1],width:H,height:H,fill:`url(#${r[2]})`})));

  const board=el("g");
  for(let v=-10;v<=10;v++){
    if(!v) continue;
    const p=px(v,v), cls=(v%5===0)?"grid-major":"grid-minor";
    board.appendChild(el("line",{class:cls,x1:p.sx,y1:PAD,x2:p.sx,y2:SIZE-PAD}));
    board.appendChild(el("line",{class:cls,x1:PAD,y1:p.sy,x2:SIZE-PAD,y2:p.sy}));
  }
  board.appendChild(el("line",{class:"axis",x1:PAD,y1:C,x2:SIZE-PAD,y2:C}));
  board.appendChild(el("line",{class:"axis",x1:C,y1:PAD,x2:C,y2:SIZE-PAD}));
  board.appendChild(el("rect",{class:"frame",x:PAD,y:PAD,width:SIZE-2*PAD,height:SIZE-2*PAD,rx:14}));
  board.appendChild(el("circle",{class:"origin",cx:C,cy:C,r:3.2}));
  svg.appendChild(board);

  [-10,-5,5,10].forEach(v=>{
    const p=px(v,v);
    svg.appendChild(el("text",{x:p.sx,y:SIZE-PAD+16,class:"tick","text-anchor":"middle"},v>0?"+"+v:v));
    svg.appendChild(el("text",{x:PAD-9,y:p.sy+3.2,class:"tick","text-anchor":"end"},v>0?"+"+v:v));
  });

  svg.appendChild(el("text",{x:C,y:PAD-30,class:"axis-cap","text-anchor":"middle"},"АВТОРИТАРИЗМ · ЭТАТИЗМ"));
  svg.appendChild(el("text",{x:C,y:SIZE-PAD+42,class:"axis-cap","text-anchor":"middle"},"ЛИБЕРТАРИАНСТВО · СВОБОДА"));
  const lt=el("text",{class:"axis-cap","text-anchor":"middle",transform:`rotate(-90 ${PAD-40} ${C})`,x:PAD-40,y:C+4});
  lt.textContent="ЛЕВЫЕ · СОЦИАЛИЗМ";svg.appendChild(lt);
  const rt=el("text",{class:"axis-cap","text-anchor":"middle",transform:`rotate(90 ${SIZE-PAD+40} ${C})`,x:SIZE-PAD+40,y:C+4});
  rt.textContent="ПРАВЫЕ · РЫНОК";svg.appendChild(rt);

  obstacles=[
    // вертикальные (повёрнутые) подписи осей — заданы вручную, getBBox их не учитывает
    {x1:PAD-54,y1:PAD,x2:PAD-26,y2:SIZE-PAD},
    {x1:SIZE-PAD+26,y1:PAD,x2:SIZE-PAD+54,y2:SIZE-PAD}
  ];
  svg.querySelectorAll('.axis-cap').forEach(t=>{
    if(!t.getAttribute('transform')) obstacles.push(rectOf(t,0,0,5));
  });

  [{x:PAD+16,y:PAD+22,t:"лево · государство",a:"start"},
   {x:SIZE-PAD-16,y:PAD+22,t:"право · государство",a:"end"},
   {x:PAD+16,y:SIZE-PAD-16,t:"лево · свобода",a:"start"},
   {x:SIZE-PAD-16,y:SIZE-PAD-16,t:"право · свобода",a:"end"}]
   .forEach(q=>{
     const t=el("text",{x:q.x,y:q.y,class:"quad-cap","text-anchor":q.a},q.t);
     svg.appendChild(t);
     obstacles.push(rectOf(t,0,0,6));
   });

  cross=el("g",{class:"cross"});
  cross.appendChild(el("line",{id:"cx",x1:0,y1:0,x2:0,y2:0}));
  cross.appendChild(el("line",{id:"cy",x1:0,y1:0,x2:0,y2:0}));
  svg.appendChild(cross);

  const layer=el("g");
  svg.appendChild(layer);

  // сами точки — тоже препятствия для чужих подписей
  PARTIES.forEach(p=>{
    const {sx,sy}=px(p.x,p.y), r=radius(p)+4;
    obstacles.push({x1:sx-r,y1:sy-r,x2:sx+r,y2:sy+r});
  });

  // крупные фракции раскладываем первыми — им достаются предпочтительные места
  const order=PARTIES.map((p,i)=>({p,i})).sort((a,b)=>b.p.seats-a.p.seats);
  order.forEach(({p,i})=>{
    const {sx,sy}=px(p.x,p.y), r=radius(p);
    const g=el("g",{class:"node","data-id":p.id,transform:`translate(${sx},${sy})`});
    g.appendChild(el("circle",{class:"pulse",r:14,stroke:p.color}));
    g.appendChild(el("circle",{class:"ring",r:r+8,stroke:p.color}));
    g.appendChild(el("circle",{class:"dot",r:0,fill:p.color,filter:"url(#glow)"}));
    const tag=el("text",{class:"tag"},p.tag);
    const seat=el("text",{class:"seat"},p.seats?`${p.seats} мандат${plural(p.seats)}`:"нет мандатов");
    g.appendChild(tag);g.appendChild(seat);
    layer.appendChild(g);

    // перебираем варианты размещения, пока подпись не перестанет пересекаться
    const tries=[p.lp,"top","right","left","bottom"].filter((v,k,arr)=>arr.indexOf(v)===k);
    let chosen=null,fallback=null;
    for(const pos of tries){
      const box=place(tag,seat,sx,sy,r,pos);
      if(!fallback) fallback={pos,box};
      if(inside(box)&&!hits(box)){chosen={pos,box};break;}
    }
    if(!chosen) chosen=fallback;
    const box=place(tag,seat,sx,sy,r,chosen.pos);
    obstacles.push(box);

    g.addEventListener("mouseenter",()=>{showTip(p,sx,sy);showCross(sx,sy);});
    g.addEventListener("mouseleave",()=>{hideTip();hideCross();});
    g.addEventListener("click",()=>select(p.id));
    setTimeout(()=>{g.classList.add("in");g.querySelector(".dot").setAttribute("r",r);},140+i*60);
  });
}
function plural(n){const a=n%10,b=n%100;if(a===1&&b!==11)return"";if(a>=2&&a<=4&&(b<10||b>=20))return"а";return"ов";}

function showCross(sx,sy){
  cross.querySelector('#cx').setAttribute('x1',C);cross.querySelector('#cx').setAttribute('y1',sy);
  cross.querySelector('#cx').setAttribute('x2',sx);cross.querySelector('#cx').setAttribute('y2',sy);
  cross.querySelector('#cy').setAttribute('x1',sx);cross.querySelector('#cy').setAttribute('y1',C);
  cross.querySelector('#cy').setAttribute('x2',sx);cross.querySelector('#cy').setAttribute('y2',sy);
  cross.classList.add('show');
}
function hideCross(){cross.classList.remove('show');}

/* ---- tooltip ---- */
const tip=document.getElementById('tip'), plot=document.getElementById('plot');
function showTip(p,sx,sy){
  tip.innerHTML=`
    <div class="tip-top"><span class="tip-dot" style="background:${p.color}"></span><span class="tip-name">${p.name}</span></div>
    <div class="tip-ideo">${p.ideology}</div>
    <div class="tip-meta">
      <span>Экономика <b>${fmt(p.x)}</b></span>
      <span>Гос. контроль <b>${fmt(p.y)}</b></span>
      <span>Госдума VIII <b>${p.seats}</b> / 450</span>
    </div>
    <div class="tip-hint">${p.seats?"Есть представительство в Госдуме":"Нет мандатов в Госдуме VIII созыва"} · клик — подробнее</div>`;
  const r=plot.getBoundingClientRect();
  tip.classList.toggle('below', sy/SIZE < 0.24);
  tip.style.left=(sx/SIZE*r.width)+"px";
  tip.style.top=(sy/SIZE*r.height)+"px";
  tip.classList.add('show');
}
function hideTip(){tip.classList.remove('show');}

/* ---- sidebar ---- */
const sideBody=document.getElementById('sideBody'),sideTitle=document.getElementById('sideTitle'),countEl=document.getElementById('count');
function visible(){
  return PARTIES.filter(p=>{
    if(filter==="duma"&&!p.seats) return false;
    if(filter==="nonduma"&&p.seats) return false;
    if(query&&!(p.name+" "+p.short+" "+p.ideology).toLowerCase().includes(query)) return false;
    return true;
  });
}
function renderList(){
  const list=visible().slice().sort((a,b)=>b.seats-a.seats);
  countEl.textContent=list.length;countEl.style.display="";
  sideTitle.textContent="Партии · мандаты в ГД";
  if(!list.length){sideBody.innerHTML=`<div class="empty">Ничего не найдено.<br>Попробуйте изменить запрос.</div>`;return;}
  sideBody.innerHTML=`<div class="plist">${list.map((p,i)=>`
    <button class="pitem${p.id===active?' active':''}" data-id="${p.id}" style="animation-delay:${i*35}ms">
      <span class="sw" style="background:${p.color}"></span>
      <span class="nm">${p.name}<small>${p.ideology}</small></span>
      <span class="mandates"><b>${p.seats}</b>мандат${plural(p.seats)}</span>
    </button>`).join('')}</div>`;
  sideBody.querySelectorAll('.pitem').forEach(b=>b.addEventListener('click',()=>select(b.dataset.id)));
}
function renderDetail(p){
  countEl.style.display="none";
  sideTitle.textContent="Карточка партии";
  const pct=(p.seats/TOTAL_SEATS*100);
  sideBody.innerHTML=`
    <div class="detail">
      <button class="back" id="back">← Все партии</button>
      <div class="d-head">
        <div class="d-badge" style="background:${p.color};color:${p.color}">${p.name.trim()[0]}</div>
        <div><h3>${p.name}</h3><div class="ideo">${p.ideology}</div></div>
      </div>
      <div class="coords">
        <div class="coord"><div class="k">Экономика</div><div class="v">${fmt(p.x)}</div>
          <div class="d">${p.x<-3?"левые":p.x>3?"правые":"центр"}</div></div>
        <div class="coord"><div class="k">Гос. контроль</div><div class="v">${fmt(p.y)}</div>
          <div class="d">${p.y<-3?"либертарианство":p.y>3?"этатизм":"центр"}</div></div>
      </div>
      <div class="mandate-box">
        <div class="mandate-top">
          <span class="k">Госдума VIII созыва</span>
          <span class="v">${p.seats} <small>/ 450 мест</small></span>
        </div>
        <div class="bar"><i id="bar" style="background:${p.color}"></i></div>
        <div class="mandate-note">${p.seats?`${pct.toFixed(1)}% состава палаты`:"Партия не преодолела барьер и не получила мандатов"}</div>
      </div>
      <div class="sect"><h4>Ключевые тезисы</h4>
        <ul>${p.theses.map(t=>`<li>${t}</li>`).join('')}</ul></div>
      <div class="sect"><h4>Почему такие координаты</h4>
        <div class="note"><p>${p.why}</p></div></div>
    </div>`;
  document.getElementById('back').addEventListener('click',()=>{active=null;syncNodes();renderList();});
  requestAnimationFrame(()=>{const b=document.getElementById('bar');if(b)b.style.width=Math.max(p.seats?2:0,pct)+"%";});
}
function select(id){
  active=(active===id)?null:id;
  syncNodes();
  active?renderDetail(PARTIES.find(p=>p.id===active)):renderList();
}
function syncNodes(){
  const vis=new Set(visible().map(p=>p.id));
  svg.querySelectorAll('.node').forEach(n=>{
    n.classList.toggle('muted',!vis.has(n.dataset.id));
    n.classList.toggle('active',n.dataset.id===active);
  });
}
function refresh(){
  if(active&&!visible().some(p=>p.id===active)) active=null;
  syncNodes();
  active?renderDetail(PARTIES.find(p=>p.id===active)):renderList();
}

/* ---- controls ---- */
const qi=document.getElementById('q'),wrap=document.getElementById('searchWrap');
qi.addEventListener('input',()=>{query=qi.value.trim().toLowerCase();wrap.classList.toggle('has-value',!!qi.value);refresh();});
document.getElementById('clearBtn').addEventListener('click',()=>{qi.value="";qi.dispatchEvent(new Event('input'));qi.focus();});
document.querySelectorAll('.chip').forEach(c=>c.addEventListener('click',()=>{
  filter=c.dataset.filter;
  document.querySelectorAll('.chip').forEach(x=>x.setAttribute('aria-pressed',x===c));
  refresh();
}));
document.addEventListener('keydown',e=>{
  if(e.key==="Escape"&&active){active=null;syncNodes();renderList();}
  if(e.key==="/"&&document.activeElement!==qi){e.preventDefault();qi.focus();}
});

/* ---- theme ---- */
const themeBtn=document.getElementById('themeBtn'),themeIcon=document.getElementById('themeIcon');
function applyTheme(t){
  document.documentElement.dataset.theme=t;
  themeIcon.style.transform="rotate(180deg) scale(.3)";
  setTimeout(()=>{themeIcon.textContent=t==="dark"?"☀️":"🌙";themeIcon.style.transform="none";},170);
  try{localStorage.setItem("pc-theme",t);}catch(e){}
}
themeBtn.addEventListener('click',()=>applyTheme(document.documentElement.dataset.theme==="dark"?"light":"dark"));
let saved="dark";try{saved=localStorage.getItem("pc-theme")||"dark";}catch(e){}
document.documentElement.dataset.theme=saved;
themeIcon.textContent=saved==="dark"?"☀️":"🌙";

draw();
renderList();
</script>
</body>
</html>
